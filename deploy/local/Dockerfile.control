# syntax=docker/dockerfile:1
FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    go mod download
COPY packages ./packages
COPY policies ./policies
COPY services ./services
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -o /out/control ./services/control/cmd/control && \
    CGO_ENABLED=0 go build -trimpath -o /out/dev-issuer ./services/control/cmd/dev-issuer && \
    CGO_ENABLED=0 go build -trimpath -o /out/model ./services/model/cmd/model && \
    CGO_ENABLED=0 go build -trimpath -o /out/executor ./services/tool-executor/cmd/executor && \
    CGO_ENABLED=0 go build -trimpath -o /out/worker ./services/worker && \
    CGO_ENABLED=0 go build -trimpath -o /out/evidence ./services/evidence
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/ /
USER 65532:65532
ENTRYPOINT ["/control"]
