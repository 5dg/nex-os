+// validateJSONValue rejects duplicate object names at every depth. The decoder
+// compares decoded names, so differently escaped spellings cannot evade it.
+func validateJSONValue(decoder *json.Decoder, depth int, objectRequired bool) error {
+	if depth > 128 {
+		return errors.New("protected header nesting limit exceeded")
+	}
+	token, err := decoder.Token()
+	if err != nil {
+		return err
+	}
+	delim, isDelim := token.(json.Delim)
+	if objectRequired && (!isDelim || delim != '{') {
+		return errors.New("protected header must be an object")
+	}
+	if !isDelim {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := make(map[string]struct{})
+		for decoder.More() {
+			name, err := decoder.Token()
+			if err != nil {
+				return err
+			}
+			key, ok := name.(string)
+			if !ok {
+				return errors.New("invalid protected header member")
+			}
+			if _, exists := seen[key]; exists {
+				return errors.New("duplicate protected header member")
+			}
+			seen[key] = struct{}{}
+			if err := validateJSONValue(decoder, depth+1, false); err != nil {
+				return err
+			}
+		}
+		end, err := decoder.Token()
+		if err != nil || end != json.Delim('}') {
+			return errors.New("invalid protected header object")
+		}
+	case '[':
+		for decoder.More() {
+			if err := validateJSONValue(decoder, depth+1, false); err != nil {
+				return err
+			}
+		}
+		end, err := decoder.Token()
+		if err != nil || end != json.Delim(']') {
+			return errors.New("invalid protected header array")
+		}
+	default:
+		return errors.New("invalid protected header delimiter")
+	}
+	return nil
+}
