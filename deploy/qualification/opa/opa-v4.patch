+func TestNexRejectSignedMalformedHeader(t *testing.T) {
+	encode := base64.RawURLEncoding.EncodeToString
+	secret := []byte("diagnostic-secret")
+	signed := func(header []byte) string {
+		input := encode(header) + "." + encode([]byte(`{"files":[],"keyid":"foo"}`))
+		mac := hmac.New(sha256.New, secret)
+		_, _ = mac.Write([]byte(input))
+		return input + "." + encode(mac.Sum(nil))
+	}
+	valid := signed([]byte(`{"alg":"HS256","kid":"foo"}`))
+	validNoKID := signed([]byte(`{"alg":"HS256"}`))
+	validEscapedKey := signed([]byte(`{"\u0061lg":"HS256","kid":"foo"}`))
+	validNested := signed([]byte(`{"alg":"HS256","kid":"foo","extension":{"x":1,"y":2}}`))
+	validSurrogatePair := signed([]byte(`{"alg":"HS256","kid":"foo","extension":"\ud83d\ude80"}`))
+	bad := map[string][]byte{
+		"invalid_utf8":            append([]byte(`{"alg":"HS256","kid":"`), 0xff, '"', '}'),
+		"malformed_json":          []byte(`{"alg":"HS256","kid":"foo"`),
+		"duplicate_alg":           []byte(`{"alg":"HS256","alg":"none","kid":"foo"}`),
+		"duplicate_kid":           []byte(`{"alg":"HS256","kid":"foo","kid":"bar"}`),
+		"duplicate_escaped_alg":   []byte(`{"alg":"HS256","\u0061lg":"none","kid":"foo"}`),
+		"duplicate_nested":        []byte(`{"alg":"HS256","kid":"foo","extension":{"x":1,"x":2}}`),
+		"algorithm_confusion":     []byte(`{"alg":"none","kid":"foo"}`),
+		"algorithm_mismatch":      []byte(`{"alg":"RS256","kid":"foo"}`),
+		"missing_algorithm":       []byte(`{"kid":"foo"}`),
+		"non_string_algorithm":    []byte(`{"alg":5,"kid":"foo"}`),
+		"non_string_kid":          []byte(`{"alg":"HS256","kid":5}`),
+		"duplicate_escaped_kid":   []byte(`{"alg":"HS256","kid":"foo","\u006bid":"bar"}`),
+		"unpaired_high_surrogate": []byte(`{"alg":"HS256","kid":"\ud800"}`),
+		"unpaired_low_surrogate":  []byte(`{"alg":"HS256","kid":"\udc00"}`),
+	}
+	keys := map[string]*KeyConfig{"foo": {Key: string(secret), Algorithm: "HS256"}}
+	for _, configuredID := range []string{"", "foo"} {
+		t.Run("configured="+configuredID, func(t *testing.T) {
+			cfg := NewVerificationConfig(keys, configuredID, "", nil)
+			if _, err := VerifyBundleSignature(SignaturesConfig{Signatures: []string{valid}}, cfg); err != nil {
+				t.Fatalf("valid signed control rejected: %v", err)
+			}
+			if _, err := VerifyBundleSignature(SignaturesConfig{Signatures: []string{validNoKID}}, cfg); err != nil {
+				t.Fatalf("valid signed control without header kid rejected: %v", err)
+			}
+			if _, err := VerifyBundleSignature(SignaturesConfig{Signatures: []string{validEscapedKey}}, cfg); err != nil {
+				t.Fatalf("valid signed control with escaped header key rejected: %v", err)
+			}
+			if _, err := VerifyBundleSignature(SignaturesConfig{Signatures: []string{validNested}}, cfg); err != nil {
+				t.Fatalf("valid signed control with nested extension rejected: %v", err)
+			}
+			if _, err := VerifyBundleSignature(SignaturesConfig{Signatures: []string{validSurrogatePair}}, cfg); err != nil {
+				t.Fatalf("valid signed control with surrogate pair rejected: %v", err)
+			}
+			for name, header := range bad {
+				t.Run(name, func(t *testing.T) {
+					files, err := VerifyBundleSignature(SignaturesConfig{Signatures: []string{signed(header)}}, cfg)
+					wantPrefix := "failed to extract key ID from headers:"
+					if name == "algorithm_confusion" || name == "algorithm_mismatch" {
+						wantPrefix = "JWT algorithm does not match configured verification key"
+					}
+					if err == nil || len(files) != 0 || !strings.HasPrefix(err.Error(), wantPrefix) {
+						t.Fatalf("malformed header not rejected at header validation: files=%v err=%v", files, err)
+					}
+				})
+			}
+		})
+	}
+}
