# syntax=docker/dockerfile:1
FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=proxy_ca,required=true SSL_CERT_FILE=/run/secrets/proxy_ca go mod download
COPY packages ./packages
COPY policies ./policies
COPY services ./services
COPY scripts/qualification-edge ./scripts/qualification-edge
COPY scripts/qualification-policy-edge ./scripts/qualification-policy-edge
COPY tests/qualification ./tests/qualification
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/qualification-edge ./scripts/qualification-edge && \
    go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/qualification-policy-edge ./scripts/qualification-policy-edge && \
    go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/qualification-issuer ./tests/qualification/cmd/oidc-issuer
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chmod=0555 /out/ /
USER 65532:65532
ENTRYPOINT ["/qualification-edge"]
