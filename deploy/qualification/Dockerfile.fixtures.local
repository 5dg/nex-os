FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS trust
FROM scratch
COPY --from=trust /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0555 bin/qualification-edge bin/qualification-policy-edge bin/qualification-issuer /
USER 65532:65532
ENTRYPOINT ["/qualification-edge"]
