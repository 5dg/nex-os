  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceMTLS": {
        "type": "mutualTLS",
        "description": "Qualification requires the declared verified service URI identity in addition to human API credentials; never a forwarded identity header."
      }
    },
    "schemas": {
      "ActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "delegation_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "delegation_id",
          "action",
          "resource_id"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
