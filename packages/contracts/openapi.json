  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "delegation_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "delegation_id",
          "action",
          "resource_id"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "require_approval"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          },
          "policy_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "decision_id",
          "effect",
          "reason_code",
          "policy_version",
          "policy_digest"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "ModelInvocation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "delegation_id": {
            "type": "string",
            "minLength": 1
          },
          "resource_id": {
            "const": "dev-model"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "required": [
          "delegation_id",
          "resource_id",
          "prompt",
          "max_output_tokens"
        ]
      },
      "ModelResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "provider",
          "model_id",
          "text",
          "decision_id"
        ]
      },
      "Delegation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1
          },
          "user_id": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "user_id",
          "permissions",
          "expires_at"
        ],
        "description": "Versioned foundation shape; not an implemented lifecycle API. Future lifecycle fields require deliberate contract evolution."
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
