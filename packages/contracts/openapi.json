  "info": {
    "title": "Nex.os foundation control API",
    "version": "0.2.0",
    "description": "Local synthetic-data alpha. Go orchestration, Rust execution authority, gRPC contracts, explicit development inference, and controlled local export. Live GovCloud/Bedrock and production identity/TLS/cryptographic assessment remain deferred."
  },
