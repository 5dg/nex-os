    "/v1/jobs/{id}/reconcile": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Recover only a durable receiver result; never executes an effect or accepts a supplied outcome.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current recovery state"
          },
          "400": {
            "description": "No client-supplied recovery fields accepted"
          },
          "403": {
            "description": "Owner or current resource authority denied"
          },
          "409": {
            "description": "Operation does not meet recovery prerequisites"
          },
          "503": {
            "description": "Required state or evidence unavailable"
          }
        }
      }
    },
